# ── Stripe ────────────────────────────────────────────────────────────────────
# Stripe > Developers > API keys > Secret key
STRIPE_SECRET_KEY=sk_live_...

# Stripe > Developers > Webhooks > ton endpoint > Signing secret
# URL du webhook à configurer : https://www.locair.fr/api/webhook
# Événements à écouter : checkout.session.completed, payment_intent.payment_failed,
#                        charge.refunded, charge.dispute.created
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Supabase ──────────────────────────────────────────────────────────────────
# Supabase > Settings > API > Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase > Settings > API > service_role (secret — ne jamais exposer côté client)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...

# ── Brevo (emails & SMS) ──────────────────────────────────────────────────────
# Brevo > Account > SMTP & API > API Keys
BREVO_API_KEY=xkeysib-...

# Nom de l'expéditeur SMS (max 11 caractères, sans espace)
BREVO_SMS_SENDER=LocAir

# ── Push notifications (VAPID) ────────────────────────────────────────────────
# Généré une seule fois avec : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=BN...
VAPID_PRIVATE_KEY=...
VAPID_SUBJECT=mailto:contact@locair.fr

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=ton@email.fr
ADMIN_PASSWORD=mot_de_passe_admin
ADMIN_TEL=+336...

# ── Divers ────────────────────────────────────────────────────────────────────
CRON_SECRET=secret_pour_proteger_les_crons
OPERATOR_TOKEN=token_operateur

# Google Places (avis Google sur la page d'accueil)
GOOGLE_PLACES_API_KEY=AIza...
GOOGLE_PLACE_ID=ChIJ...

# WhatsApp Business API (optionnel)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
